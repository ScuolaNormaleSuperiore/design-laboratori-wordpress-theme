{
  "name": "design-laboratori-wordpress-theme",
  "version": "2.0.3",
  "description": "Tema Wordpress dei Laboratori Italiani",
  "main": "index.js",
  "scripts": {
    "build": "npm run minify:css && npm run minify:js",
    "lint": "npm run lint:php",
    "lint:php": "composer run lint:php -- .",
    "lint:php:file": "composer run lint:php --",
    "lint:php:fix": "composer run lint:php:fix -- .",
    "lint:php:fix:file": "composer run lint:php:fix --",
    "version": "node SETUP/npm_scripts/config-sync && git add style.css publiccode.yml VERSION.txt",
    "postversion": "echo \"You can now publish your tag with 'git push --follow-tags'\"",
    "minify:css": "node SETUP/npm_scripts/minify-css.js",
    "minify:js": "node SETUP/npm_scripts/minify-js.js",
    "assets:sync": "node SETUP/npm_scripts/sync-bootstrap-italia.mjs",
    "create_layout": "npx sass --load-path=node_modules assets/scss/bootstrap-italia-custom.scss:assets/css/compiled/bootstrap-italia-custom.min.css --style=compressed",
    "update_layout_win": "npm run create_layout && xcopy .\\assets\\css\\compiled\\bootstrap-italia-custom.min.* .\\assets\\css\\ /Y",
    "update_layout_linux": "npm run create_layout && cp -f ./assets/css/compiled/bootstrap-italia-custom.min.* ./assets/css/",
    "status:scan": "node tests/report/status-report/scan.js",
    "status:scan:gate": "node tests/report/status-report/scan.js --gate",
    "status:scan:install-browser": "npx playwright install chromium",
    "status:compare": "node tests/report/status-report/compare.js",
    "html:scan": "node tests/report/html-report/scan.js",
    "html:scan:gate": "node tests/report/html-report/scan.js --gate",
    "html:compare": "node tests/report/html-report/compare.js",
    "pa11y:scan": "node tests/report/pa11y-report/scan.js",
    "pa11y:scan:gate": "node tests/report/pa11y-report/scan.js --gate",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScuolaNormaleSuperiore/design-laboratori-wordpress-theme.git"
  },
  "author": "Presidenza del Consiglio dei Ministri",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/ScuolaNormaleSuperiore/design-laboratori-wordpress-theme/issues"
  },
  "homepage": "https://github.com/ScuolaNormaleSuperiore/design-laboratori-wordpress-theme#readme",
  "dependencies": {
    "bootstrap-italia": "3.0.0-beta.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "clean-css-cli": "^5.4.2",
    "pa11y-ci": "^5.0.0",
    "pa11y-ci-reporter-html": "^9.0.0",
    "playwright": "^1.50.0",
    "replace-in-file": "^6.3.5",
    "sass": "^1.81.0",
    "uglify-js": "^3.17.4",
    "vnu-jar": "^26.3.17"
  }
}
