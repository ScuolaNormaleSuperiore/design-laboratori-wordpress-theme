#!/usr/bin/env bash
set -euo pipefail

echo "[DLI pre-commit] Check commit text ..." >&2

# Block Co-Authored-By trailers that credit an AI assistant (see AGENTS/GIT_WORKFLOW.md).
if grep -Eiq '^Co-Authored-By:.*(claude|chatgpt|codex|copilot|gemini|openai|anthropic)' "$1"; then
	echo "Commit blocked: remove the Co-Authored-By trailer that credits an AI assistant" >&2
	exit 1
fi
