{
  "name": "sns/design-laboratori-wordpress-theme",
  "type": "project",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.1",
    "phpstan/phpstan": "1.12",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^4.0",
    "php-stubs/wordpress-stubs": "^7.1"
  },
  "scripts": {
    "lint:php": "phpcs --standard=phpcs.xml.dist",
    "lint:php:fix": "phpcbf --standard=phpcs.xml.dist",
    "lint:phpstan": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=2G",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": [
      "@php tests/utils/fetch-test-plugins.php",
      "phpunit -c phpunit-integration.xml"
    ],
    "test:e2e": "npm run test:e2e --",
    "test:e2e:headed": "npm run test:e2e:headed --",
    "test:e2e:ui": "npm run test:e2e:ui --"
  },
  "scripts-descriptions": {
    "test:unit": "Unit tests (PHPUnit, no WordPress)",
    "test:integration": "Integration tests (PHPUnit on a real WordPress, dedicated database)",
    "test:e2e": "Functional tests (Playwright on the E2E site; needs DLI_E2E_SITE_PATH). Extra options after --",
    "test:e2e:headed": "Functional tests with a visible browser",
    "test:e2e:ui": "Functional tests in Playwright UI mode"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
