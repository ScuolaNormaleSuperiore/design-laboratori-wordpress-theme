{
  "name": "sns/design-laboratori-wordpress-theme",
  "type": "project",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.1",
    "phpstan/phpstan": "1.12",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^4.0",
    "php-stubs/wordpress-stubs": "^7.1"
  },
  "scripts": {
    "lint:php": "phpcs --standard=phpcs.xml.dist",
    "lint:php:fix": "phpcbf --standard=phpcs.xml.dist",
    "lint:phpstan": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=2G",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": [
      "@php tests/utils/fetch-test-plugins.php",
      "phpunit -c phpunit-integration.xml"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
