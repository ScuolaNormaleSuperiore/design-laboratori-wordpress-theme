includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  dynamicConstantNames:
    - ABSPATH
    - CMB2_VERSION
    - DLI_PUBLICATION_HAS_DETAIL
  level: 3
  parallel:
    maximumNumberOfProcesses: 1
  scanFiles:
    - tests/utils/wordpress-runtime-stubs.php
    - tests/utils/theme-runtime-stubs.php
    - tests/utils/wordpress-lite-stubs.php
    - tests/utils/third-party-runtime-stubs.php
    - tests/utils/polylang-stubs.php
    - tests/utils/really-simple-captcha-stubs.php
    - config-lab.php
    - config-pages.php
    - config-menu.php
  paths:
    - inc
    - page-templates
    - template-parts
    - archive.php
    - page.php
    - header.php
    - footer.php
    - functions.php
  excludePaths:
    - vendor/*
    - inc/vendor/*
    - node_modules/*
    - tests/*
    - assets/*
    - languages/*
    - DEV/*
    - SETUP/*
    - DOC/*
    - AGENTS/*
