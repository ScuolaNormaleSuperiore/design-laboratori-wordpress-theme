includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  dynamicConstantNames:
    - ABSPATH
    - CMB2_VERSION
    - DLI_PUBLICATION_HAS_DETAIL
    - DLI_POST_TYPES_TO_TRANSLATE
  level: 4
  parallel:
    maximumNumberOfProcesses: 1
  scanFiles:
    - tests/phpstan/wordpress-runtime-stubs.php
    - tests/phpstan/theme-runtime-stubs.php
    - tests/phpstan/wordpress-lite-stubs.php
    - tests/phpstan/third-party-runtime-stubs.php
    - tests/phpstan/polylang-stubs.php
    - tests/phpstan/really-simple-captcha-stubs.php
    - config-lab.php
    - config-pages.php
    - config-menu.php
  paths:
    - inc
    - page-templates
    - template-parts
    - 404.php
    - archive.php
    - category.php
    - config-lab.php
    - config-menu.php
    - config-pages.php
    - footer.php
    - functions.php
    - header.php
    - home.php
    - index.php
    - page.php
    - single-brevetto.php
    - single-evento.php
    - single-indirizzo-di-ricerca.php
    - single-luogo.php
    - single-notizia.php
    - single-persona.php
    - single-post.php
    - single-progetto.php
    - single-pubblicazione.php
    - single-risorsa-tecnica.php
    - single-spinoff.php
  excludePaths:
    - vendor/*
    - inc/vendor/*
    - node_modules/*
    - tests/*
    - assets/*
    - languages/*
    - DEV/*
    - SETUP/*
    - DOC/*
    - AGENTS/*
