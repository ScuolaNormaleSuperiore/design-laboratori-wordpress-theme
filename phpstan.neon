parameters:
  level: 1
  parallel:
    maximumNumberOfProcesses: 1
  scanFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - tests/utils/wordpress-runtime-stubs.php
    - tests/utils/theme-runtime-stubs.php
    - tests/utils/wordpress-lite-stubs.php
    - tests/utils/polylang-stubs.php
    - tests/utils/really-simple-captcha-stubs.php
    - config-lab.php
    - config-pages.php
    - config-menu.php
  paths:
    - inc
    - page-templates
    - template-parts
    - archive.php
    - page.php
    - header.php
    - footer.php
    - functions.php
  excludePaths:
    - vendor/*
    - inc/vendor/*
    - node_modules/*
    - tests/*
    - assets/*
    - languages/*
    - DEV/*
    - SETUP/*
    - DOC/*
    - AGENTS/*
